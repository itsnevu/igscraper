# Isi nilai asli, lalu jalankan di terminal: source .env
# Kalau dibiarkan kosong, alert dilewati (script tetap jalan normal).
export TG_TOKEN=""        # token bot dari @BotFather, contoh 123456:AAH...
export TG_CHAT=""         # chat ID kamu (angka)
export SLACK_WEBHOOK=""   # https://hooks.slack.com/services/T.../B.../...
export OPENROUTER_API_KEY=""   # openrouter.ai/keys — opsional, untuk memahami prompt
export OPENROUTER_MODEL=""   # kosong = pilih model gratis otomatis
